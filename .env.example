# LLM copywriter (optional) — pick one and pass `--llm <provider>` (or set llm.provider in config).
# Keys are read from the environment only; Shark never stores or logs them.
# OPENAI_API_KEY=...        # --llm openai   (also used by --llm codex)
# CODEX_API_KEY=...         # --llm codex    (OpenAI-compatible; set llm.baseUrl for a gateway)
# ANTHROPIC_API_KEY=...     # --llm anthropic
# GEMINI_API_KEY=...        # --llm gemini   (GOOGLE_API_KEY also accepted)

# Shark Configuration
# SHARK_DRY_RUN=true
# SHARK_BROWSER_PROFILE=~/.shark/browser-profile
# SHARK_LANGUAGE=he
